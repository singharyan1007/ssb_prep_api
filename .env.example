APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_USER=ssbprep
POSTGRES_PASSWORD=ssbprep
POSTGRES_DB=ssbprep
POSTGRES_PORT=5432

# Inside Compose the hostname is `postgres`. On the host use localhost.
DATABASE_URL=postgresql+psycopg://ssbprep:ssbprep@localhost:5432/ssbprep

# Service key for internal ingest (tests/fixtures). Not a user JWT.
INGEST_KEY=change-me-local-only

# JWT — filled in Milestone 1 Lesson 1.4
JWT_SECRET=change-me-local-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
